<?xml version="1.0" encoding="utf-8"?>
<!--
  Huawei Cloud Panel – implantação no IIS com HttpPlatformHandler (API como .exe).
  Requer: HttpPlatformHandler instalado (https://www.iis.net/downloads/microsoft/httpplatformhandler).
  O Setup-IIS.ps1 atualiza processPath com o caminho absoluto do exe após a instalação.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <httpPlatform processPath=".\Huawei-Cloud-Panel-API.exe"
                  arguments=""
                  startupTimeLimit="20"
                  startupRetryCount="3"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\api-stdout.log">
      <environmentVariables>
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </httpPlatform>
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
