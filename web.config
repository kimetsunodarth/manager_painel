<?xml version="1.0" encoding="utf-8"?>
<!--
  Ananim Huawei Painel – implantação no IIS com iisnode.
  Requer: IIS com URL Rewrite Module e iisnode instalados.
  Segurança: NODE_ENV=production, logs apenas em arquivo, sem debug exposto.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="backend/server.js" verb="*" modules="iisnode" resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="Block iisnode debug" stopProcessing="true">
          <match url="^iisnode.*" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
        <rule name="Node - todas as requisições para o app Node">
          <match url="/*" />
          <action type="Rewrite" url="backend/server.js" />
        </rule>
      </rules>
    </rewrite>
    <iisnode
      nodeProcessCommandLine="&quot;%ProgramFiles%\nodejs\node.exe&quot;"
      nodeEnv="production"
      loggingEnabled="true"
      logDirectory="iisnode"
      debuggingEnabled="false"
      devErrorsEnabled="false"
      maxNamedPipeConnectionRetry="24"
      maxConcurrentRequestsPerProcess="1024"
      maxNamedPipeConnectionRetryDelay="250"
      maxConcurrentProcessesPerApplication="1"
      minProcessesPerApplication="0"
      maxProcessesPerApplication="1"
      asyncCompletionThreadCount="0"
      initialRequestBufferSize="4096"
      maxRequestBufferSize="65536"
      watchedFiles="web.config;*.js"
      uncFileChangesPollingInterval="5000"
      gracefulShutdownTimeout="60000"
      />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".env" />
          <add segment="users.json" />
          <add segment="actionLog.json" />
          <add segment="agendamentos.json" />
          <add segment="iisnode" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="0.00:00:00" />
    </staticContent>
  </system.webServer>
</configuration>
