<?xml version="1.0" encoding="utf-8"?>
<!--
  Ananim Manager Painel – IIS (HttpPlatformHandler).
  Quando a raiz do site é a pasta do projeto: executa Node com backend/src/index.js.
  Quando for instalação com .exe: use o web.config do installer/iis (processPath=.\Ananim-Manager-Painel-API.exe).
  Requer: HttpPlatformHandler instalado. Build do frontend: npm run build em frontend/ (o backend serve de frontend/dist se public/ não existir).
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <httpPlatform processPath="node.exe"
                  arguments="backend\src\index.js"
                  startupTimeLimit="60"
                  startupRetryCount="3"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\api-stdout.log">
      <environmentVariables>
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </httpPlatform>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".env" />
          <add segment=".encryption_key" />
          <add segment="config.enc" />
          <add segment="key.bin" />
          <add segment=".git" />
          <add segment="logs" />
          <add segment="config" />
          <add segment="data" />
          <add segment="lib" />
          <add segment="frontend" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
