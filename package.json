{
  "name": "ananim-huawei-panel-installer",
  "version": "1.0.0",
  "description": "Instalador/Setup do Ananim Huawei Painel (Windows IIS e Linux)",
  "private": true,
  "main": "installer.js",
  "bin": "installer.js",
  "scripts": {
    "build:win": "pkg . --targets node18-win-x64 --output dist/Setup-Ananim-Panel.exe",
    "build:linux": "pkg . --targets node18-linux-x64 --output dist/setup-ananim-panel",
    "build": "node build-exe.js",
    "build:all": "npm run build:win && npm run build:linux"
  },
  "pkg": {
    "scripts": "installer.js",
    "assets": "Setup-IIS.ps1",
    "targets": ["node18-win-x64", "node18-linux-x64"],
    "outputPath": "dist"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
