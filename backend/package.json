{
  "name": "huawei-cloud-panel-backend",
  "version": "1.0.0",
  "description": "API backend Huawei Cloud Panel (alternativa ao Python)",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build:exe": "pkg . --targets node18-win-x64 --output dist/Huawei-Cloud-Panel-API.exe",
    "build:decrypt-logs": "pkg decrypt-logs.js --targets node18-win-x64 --output dist/Descriptografar-Logs.exe",
    "encrypt-config": "node scripts/encrypt-config.js"
  },
  "pkg": {
    "scripts": ["config.js", "ecsClient.js", "huaweiClient.js", "huaweiSigner.js", "schedules.js", "users.js", "actionLog.js", "utils/config-loader.js", "utils/encrypted-line-log.js"],
    "assets": [],
    "outputPath": "dist"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "node-cron": "^3.0.3",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
