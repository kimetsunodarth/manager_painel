# SSH Águas Pratas: jump host (aguasweb2) + destino (aguassql)
# Copie para .env, preencha e rode: npm run encrypt-client-credentials -- aguas-pratas
# O .env NÃO deve ser commitado; apenas credentials.enc (gerado) pode ficar no repositório.

# Jump host (VM Web - primeiro login)
SSH_SQL_JUMP_HOST=119.8.87.121
SSH_SQL_JUMP_PORT=22
SSH_SQL_JUMP_USER=worker
SSH_SQL_JUMP_PASSWORD=senha_jump

# Destino final (VM SQL - a partir do jump)
SSH_SQL_DISPLAY_NAME=aguassql
SSH_SQL_HOST=192.168.203.50
SSH_SQL_USER=worker
SSH_SQL_PORT=22
SSH_SQL_PASSWORD=senha_sql
