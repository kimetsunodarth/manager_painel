# Conta 1: RAMO_SISTEMAS (São Paulo e Santiago)
RAMO_AK=your_ak_here
RAMO_SK=your_sk_here

# Conta: ANANIMPROG (São Paulo e Santiago – mesmo escopo que RAMO_SISTEMAS)
ANANIMPROG_AK=your_ak_here
ANANIMPROG_SK=your_sk_here

# Conta 2: ANANIMCLOUD (São Paulo)
ANANIM_AK=your_ak_here
ANANIM_SK=your_sk_here

# Conta teste: ANANIMPRO (São Paulo) – mesmo uso que ANANIMCLOUD, outro par AK/SK
ANANIMPRO_AK=your_ak_here
ANANIMPRO_SK=your_sk_here

# Conta 3: RSDONE (Santiago)
RSDONE_AK=your_ak_here
RSDONE_SK=your_sk_here

# Conta 4: MOOVE_RAMOSISTEMAS (São Paulo)
MOOVE_AK=your_ak_here
MOOVE_SK=your_sk_here

# Segurança (obrigatório em produção)
# Gere um valor forte: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Também usado para criptografar users.json, agendamentos.json e actionLog.json em disco
SESSION_SECRET=altere_em_producao
# Senhas: mínimo 8 caracteres, 1 letra, 1 número e 1 caractere especial (ex.: !@#$%&*)

# Produção: defina NODE_ENV=production e opcionalmente:
# NODE_ENV=production
# CORS_ORIGIN=https://seu-dominio.com
# SESSION_MAX_AGE_MS=86400000
# COOKIE_SECURE=false  # use em http://localhost (ex.: IIS porta 8088) para o login funcionar
